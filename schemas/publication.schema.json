{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhope-ops/90-161.Z/schemas/publication.schema.json",
  "title": "90-161.Z publication content (layer L1)",
  "description": "Content only. There are no font, size, spacing or style fields: format comes from scripts/gov/New-Publication.ps1. Inline markup allowed in text: {i}italic{/i}, {b}bold{/b}. Tier numbers such as (T-3) are bolded by the renderer. Rule IDs: docs/format-rules.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "directive",
        "byOrderOf",
        "issuerLine",
        "typeAndNumber",
        "designator",
        "date",
        "seriesTitle",
        "title",
        "accessibility",
        "releasability",
        "opr",
        "certifiedBy",
        "certifiedByName"
      ],
      "properties": {
        "action": {
          "enum": [
            "new",
            "rewrite",
            "ic",
            "ac"
          ],
          "description": "new publication, rewrite, interim change, administrative change"
        },
        "directive": {
          "type": "boolean",
          "description": "true for directive publications (F-019, F-029)"
        },
        "integratedSupplement": {
          "type": "boolean",
          "description": "exempts F-005 (4.5.3.4 exception)"
        },
        "byOrderOf": {
          "enum": [
            "SECRETARY OF THE AIR FORCE",
            "COMMANDER",
            "CHIEF, NATIONAL GUARD BUREAU"
          ],
          "description": "F-013 (4.5.4.1)"
        },
        "byOrderOfUnit": {
          "type": "string",
          "description": "optional second line under BY ORDER OF THE COMMANDER"
        },
        "issuerLine": {
          "type": "string",
          "description": "first line of the right header column"
        },
        "typeAndNumber": {
          "type": "string",
          "description": "publication type and number, e.g. INSTRUCTION 99-101 (4.5.4.3)"
        },
        "designator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "running header and file name, no spaces (3.8.2)"
        },
        "date": {
          "type": "string",
          "description": "(Date) for drafts (4.5.4.4)"
        },
        "dateLines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. Incorporating Change 1, 14 JULY 2025"
        },
        "seriesTitle": {
          "type": "string",
          "description": "AFSC series title, rendered in italics (4.5.4.5)"
        },
        "title": {
          "type": "string",
          "description": "all capital letters (4.5.4.6)"
        },
        "accessibility": {
          "type": "string",
          "description": "statement text without the label (Table 4.2)"
        },
        "accessibilityLink": {
          "type": "object",
          "description": "optional hyperlink inside the accessibility statement (PFM 13 Nov: the wing site's publications list); text must appear in meta.accessibility",
          "additionalProperties": false,
          "required": ["text", "url"],
          "properties": {
            "text": { "type": "string" },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "releasability": {
          "type": "string",
          "description": "statement text without the label (Table 4.3)"
        },
        "opr": {
          "type": "string",
          "description": "office symbol only (4.5.4.10)"
        },
        "certifiedBy": {
          "type": "string",
          "description": "office symbol only (4.5.4.11)"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "designator",
              "date"
            ],
            "additionalProperties": false,
            "properties": {
              "designator": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "description": "D Month YYYY (4.5.4.12)"
              }
            }
          }
        },
        "shieldImage": {
          "type": [
            "string",
            "null"
          ],
          "description": "local path to the shield image on the gov device (4.5.4.2)"
        },
        "certifiedByName": {
          "type": "string",
          "description": "rank (if any) and name of the certifying official, without parentheses; renderer prints '(<value>)' under Certified by (PFM, 2026-11-11; 15 of 19 published covers)"
        },
        "titleLines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "optional manual title line breaks (DAFMAN 90-161 cover breaks its title manually)"
        },
        "supplementLines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "optional right-column group for supplements, e.g. organization, 'Supplement', supplement date (L-010c)"
        }
      }
    },
    "opening": {
      "type": "string",
      "description": "free-text opening paragraph (4.5.5); use openingParts instead when possible"
    },
    "summaryOfChanges": {
      "type": [
        "string",
        "null"
      ],
      "description": "rewrites and ICs only (4.5.6)"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "signature": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "approving official authentication block lines (4.5.10)"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "openingParts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "antecedent",
        "applicability"
      ],
      "description": "Opening paragraph slots. Code adds the fixed DAFMAN 90-161 statements (4.5.5.8 records, 4.5.5.9 DAF Form 847, Table 4.5 supplementing, 4.5.5.11 waiver) in 4.5.5 order.",
      "properties": {
        "antecedent": {
          "type": "string",
          "description": "publication(s) implemented, title in {i}italics{/i}; renderer writes 'This publication implements <antecedent>.' (4.5.5.1)"
        },
        "purpose": {
          "type": "string",
          "description": "one or two sentences on what the publication covers (4.5.5)"
        },
        "applicability": {
          "type": "string",
          "description": "full applicability sentence(s) (4.5.5.2, Table 4.4)"
        },
        "privacyAct": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "authority",
            "sorn"
          ],
          "additionalProperties": false,
          "properties": {
            "authority": {
              "type": "string"
            },
            "sorn": {
              "type": "string",
              "description": "SORN number and title"
            }
          },
          "description": "only when PII is collected (4.5.5.3)"
        },
        "copyright": {
          "type": "boolean",
          "description": "4.5.5.4"
        },
        "paperworkReduction": {
          "type": "boolean",
          "description": "4.5.5.5"
        },
        "punitiveScope": {
          "type": [
            "string",
            "null"
          ],
          "description": "'paragraph 2.3' or 'section'; adds the 4.5.5.6 statement"
        },
        "statutory": {
          "type": [
            "string",
            "null"
          ],
          "description": "other statutory requirements (4.5.5.7)"
        },
        "supplement": {
          "enum": [
            "may",
            "mayNot"
          ],
          "description": "Table 4.5 item 2 (may) or item 3 (mayNot)"
        },
        "tradeNames": {
          "type": "boolean",
          "description": "adds the 4.5.5.12 disclaimer as the last sentence"
        }
      }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": [
        "title",
        "paragraphs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "all capital letters (4.5.9.7.4.5)"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "heading; main paragraphs need one (4.5.9.2)"
        },
        "text": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "text only; renderer adds bold Note: (4.6.2)"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "text only; renderer adds bold Exception: (4.6.3)"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "non-directive publications only (4.5.9.3)"
        },
        "revised": {
          "type": "boolean",
          "description": "margin bar for interim changes (4.5.6.2)"
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "title",
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "attachment": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "glossary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "references": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prescribedForms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "adoptedForms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "abbreviations": {
              "$ref": "#/$defs/pairs"
            },
            "officeSymbols": {
              "$ref": "#/$defs/pairs"
            },
            "terms": {
              "$ref": "#/$defs/pairs"
            }
          }
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        }
      }
    }
  }
}
