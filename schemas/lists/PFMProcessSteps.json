{
  "list": "PFMProcessSteps",
  "title": "PFM Process Steps",
  "description": "Publications and Forms Manager (PFM) list of process steps for one publication action, derived from Department of the Air Force Manual (DAFMAN) 90-161, with Table A5.2 target business days. Status: draft, not verified.",
  "template": "GenericList",
  "ref": "ARCHITECTURE s3 (Stages list); docs/process-model.md Stages table. Members read only; only the PFM office edits (PFM 2026-11-12, P2A).",
  "fields": [
    {
      "internalName": "Title",
      "displayName": "Title",
      "type": "Text",
      "required": true,
      "builtIn": true,
      "ref": "docs/process-model.md Stages table, column Stage"
    },
    {
      "internalName": "StepNumber",
      "displayName": "Step Number",
      "type": "Number",
      "required": true,
      "ref": "docs/process-model.md Stages table, column #"
    },
    {
      "internalName": "DAFMANRef",
      "displayName": "DAFMAN Reference",
      "type": "Text",
      "required": true,
      "ref": "docs/process-model.md Stages table, column Ref (ARCHITECTURE s3: Stages carries paragraph references)",
      "description": "Paragraph or table in Department of the Air Force Manual (DAFMAN) 90-161."
    },
    {
      "internalName": "ExitCondition",
      "displayName": "Exit Condition",
      "type": "Note",
      "required": false,
      "ref": "docs/process-model.md Stages table, column Exit condition"
    },
    {
      "internalName": "IsOptional",
      "displayName": "Optional Step",
      "type": "Boolean",
      "required": false,
      "ref": "DAFMAN 90-161 3.3 (pre-coordination is optional)"
    },
    {
      "internalName": "TargetBusinessDays",
      "displayName": "Target Business Days",
      "type": "Number",
      "required": false,
      "ref": "DAFMAN 90-161 Table A5.2 (milestone goals in business days); PFM 2026-11-11 (r7, design check decision 1A)"
    },
    {
      "internalName": "AppliesTo",
      "displayName": "Applies To",
      "type": "Choice",
      "required": false,
      "ref": "List design 2026-11-12 s3: PFM 1A (12 Nov); the action types the stage applies to, from DAFMAN 90-161 Table A5.1 (docs/dafman-coverage/part-6.md, \"Applies To fill\")",
      "choices": [
        "New",
        "Rewrite",
        "Interim Change",
        "Administrative Change",
        "Guidance Memorandum",
        "Certify Current",
        "Rescind",
        "Transfer",
        "Corrective Action",
        "Reissue Guidance Memorandum",
        "Change OPR",
        "Revise"
      ],
      "multi": true,
      "description": "Office of Primary Responsibility (OPR), as in the choice value Change OPR."
    }
  ],
  "views": [
    {
      "name": "PFM - By Step Number",
      "fields": [
        "StepNumber",
        "Title",
        "DAFMANRef",
        "TargetBusinessDays",
        "IsOptional",
        "ExitCondition"
