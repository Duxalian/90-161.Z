{
  "list": "PFMPublications",
  "title": "PFM Publications",
  "description": "One row per publication or form action the PFM tracks (ARCHITECTURE s3).",
  "template": "GenericList",
  "ref": "ARCHITECTURE s3 (Publications list)",
  "fields": [
    {
      "internalName": "Title",
      "displayName": "Title",
      "type": "Text",
      "required": true,
      "builtIn": true,
      "ref": "ARCHITECTURE s3 (one row per publication action)"
    },
    {
      "internalName": "ActionType",
      "displayName": "Action Type",
      "type": "Choice",
      "required": true,
      "choices": [
        "New",
        "Rewrite",
        "Change",
        "Certify as Current",
        "Rescind"
      ],
      "ref": "ARCHITECTURE s3 (action list: new, rewrite, change, supplement, OI, certify-as-current, rescind); Supplement and OI moved to Publication Type (PFM 2026-11-11)"
    },
    {
      "internalName": "ProductType",
      "displayName": "Product Type",
      "type": "Choice",
      "required": true,
      "choices": [
        "Publication",
        "Form"
      ],
      "default": "Publication",
      "ref": "DAFMAN 90-161 6.4.2 (the PI covers publications and forms); PFM 2026-11-11 (column, not a separate list)"
    },
    {
      "internalName": "PublicationType",
      "displayName": "Publication Type",
      "type": "Choice",
      "required": false,
      "choices": [
        "Instruction",
        "Manual",
        "Supplement",
        "Operating Instruction",
        "Guidance Memorandum",
        "Instructional Checklist"
      ],
      "ref": "DAFMAN 90-161 1.1.2 and Table A11.1 (directive publication types an installation may issue). Only directive publications are tracked (PFM 2026-11-11). Blank for forms"
    },
    {
      "internalName": "Series",
      "displayName": "Series",
      "type": "Lookup",
      "required": false,
      "lookup": {
        "list": "PFMSeries",
        "showField": "Title"
      },
      "indexed": true,
      "ref": "DAFMAN 90-161 4.3.1 and Attachment 2 Table A2.1 (series number and title); PFM 2026-11-11"
    },
    {
      "internalName": "PublicationNumber",
      "displayName": "Publication Number",
      "type": "Text",
      "required": false,
      "ref": "DAFMAN 90-161 6.4.2 (PI entries identify each publication)"
    },
    {
      "internalName": "ProcessStep",
      "displayName": "Process Step",
      "type": "Lookup",
      "required": true,
      "lookup": {
        "list": "PFMProcessSteps",
        "showField": "Title"
      },
      "ref": "ARCHITECTURE s3 (Publications -> process steps); docs/process-model.md"
    },
    {
      "internalName": "ActionStatus",
      "displayName": "Action Status",
      "type": "Choice",
      "required": true,
      "choices": [
        "On Track",
        "On Hold",
        "Stalled"
      ],
      "default": "On Track",
      "ref": "PFM 2026-11-11 (flag a stalled action); separate from Process Step and from Endorsement Status (one meaning per label)"
    },
    {
      "internalName": "StatusNotes",
      "displayName": "Status Notes",
      "type": "Note",
      "required": false,
      "appendOnly": true,
      "ref": "PFM 2026-11-11 (notes when an action is stalled); append-only so each note keeps its date and author"
    },
    {
      "internalName": "OPR",
      "displayName": "OPR",
      "type": "Lookup",
      "required": false,
      "lookup": {
        "list": "PFMOffices",
        "showField": "Title"
      },
      "ref": "Office symbol of the office of primary responsibility, from PFM Offices so each symbol has one spelling (PFM 2026-11-11); DAFMAN 90-161 5.1.5"
    },
    {
      "internalName": "Requester",
      "displayName": "Requester",
      "type": "User",
      "required": false,
      "indexed": true,
      "ref": "PFM 2026-11-11 (gap review item 6): the app sets it to the person who asked; Power Apps filters on its Email (Created By does not delegate past 2,000 rows) and the PFM can enter a request for someone else"
    },
    {
      "internalName": "AO",
      "displayName": "AO",
      "type": "User",
      "required": false,
      "ref": "DAFMAN 90-161 (action officer, AO); PFM 2026-11-11 (person from the GAL, shows the user's card)"
    },
    {
      "internalName": "DraftLink",
      "displayName": "Draft Link",
      "type": "URL",
      "required": false,
      "ref": "ARCHITECTURE s3 (Drafts library) and s4 step 3 (draft link sent to endorser)"
    },
    {
      "internalName": "CoordinationSuspense",
      "displayName": "Coordination Suspense",
      "type": "DateTime",
      "required": false,
      "ref": "DAFMAN 90-161 5.2 (OPR sets suspense; coordinators get 15 business days, T-3)"
    }
  ],
  "views": [
    {
      "name": "PFM - Queue",
      "fields": [
        "Title",
        "ProductType",
        "ActionType",
        "ProcessStep",
        "ActionStatus",
        "OPR",
        "Requester",
        "AO",
        "CoordinationSuspense"
      ],
      "orderBy": [
        {
          "field": "CoordinationSuspense",
          "ascending": true
        }
      ],
      "default": false,
      "ref": "ARCHITECTURE s3 (Power Apps: the PFM's work queue; List views: PFM admin views)"
    },
    {
      "name": "PFM - Stalled or On Hold",
      "fields": [
        "Title",
        "ProcessStep",
        "ActionStatus",
        "AO",
        "StatusNotes"
      ],
      "orderBy": [
        {
          "field": "Modified",
          "ascending": true
        }
      ],
      "where": {
        "field": "ActionStatus",
        "op": "Neq",
        "type": "Choice",
        "value": "On Track"
      },
      "default": false,
      "ref": "PFM 2026-11-11 (find stalled actions)"
    }
  ]
}
