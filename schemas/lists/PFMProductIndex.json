{
  "list": "PFMProductIndex",
  "title": "PFM Product Index",
  "description": "Product Index (PI) of all applicable organizational publications and forms that the PFM maintains (DAFMAN 90-161 6.4.2, T-3).",
  "template": "GenericList",
  "ref": "DAFMAN 90-161 6.4.2; docs/process-model.md stage 9 (updates the PI)",
  "fields": [
    {
      "internalName": "Title",
      "displayName": "Title",
      "type": "Text",
      "required": true,
      "builtIn": true,
      "ref": "DAFMAN 90-161 6.4.2 (PI lists publications and forms by title)"
    },
    {
      "internalName": "ProductType",
      "displayName": "Product Type",
      "type": "Choice",
      "required": true,
      "choices": [
        "Publication",
        "Form"
      ],
      "default": "Publication",
      "ref": "DAFMAN 90-161 6.4.2 (publications and forms)"
    },
    {
      "internalName": "PublicationType",
      "displayName": "Publication Type",
      "type": "Choice",
      "required": false,
      "choices": [
        "Instruction",
        "Manual",
        "Supplement",
        "Operating Instruction",
        "Guidance Memorandum",
        "Instructional Checklist",
        "Pamphlet",
        "Handbook",
        "Visual Aid"
      ],
      "ref": "DAFMAN 90-161 1.1.2 (publication types: directive or non-directive, stand-alone or supplement), 1.1.3 and Tables A11.1/A11.2 (types an installation may issue); PFM 2026-11-11. Blank for forms"
    },
    {
      "internalName": "PublicationCategory",
      "displayName": "Publication Category",
      "type": "Choice",
      "required": false,
      "choices": [
        "Directive",
        "Non-directive"
      ],
      "ref": "DAFMAN 90-161 1.1.2 (overall categories: directive, non-directive); replaces the Directive Publication yes/no column (PFM 2026-11-11)"
    },
    {
      "internalName": "Series",
      "displayName": "Series",
      "type": "Lookup",
      "required": false,
      "lookup": {
        "list": "PFMSeries",
        "showField": "Title"
      },
      "indexed": true,
      "ref": "DAFMAN 90-161 4.3.1 and Attachment 2 Table A2.1 (series number and title); PFM 2026-11-11"
    },
    {
      "internalName": "OPR",
      "displayName": "OPR",
      "type": "Lookup",
      "required": false,
      "lookup": {
        "list": "PFMOffices",
        "showField": "Title"
      },
      "ref": "Office symbol of the office of primary responsibility, from PFM Offices so each symbol has one spelling (PFM 2026-11-11); DAFMAN 90-161 5.1.5"
    },
    {
      "internalName": "PublicationNumber",
      "displayName": "Publication Number",
      "type": "Text",
      "required": false,
      "ref": "DAFMAN 90-161 6.4.2 (PI entries identify each publication)"
    },
    {
      "internalName": "Publication",
      "displayName": "Tracked Publication",
      "type": "Lookup",
      "required": false,
      "lookup": {
        "list": "PFMPublications",
        "showField": "Title"
      },
      "ref": "docs/process-model.md stage 9 (posting updates the PI); ties a PI entry to its tracked action"
    },
    {
      "internalName": "PostedLink",
      "displayName": "Posted Location",
      "type": "URL",
      "required": false,
      "ref": "DAFMAN 90-161 6.4.1 (PFMs distribute on approved websites or other approved methods)"
    },
    {
      "internalName": "ProductStatus",
      "displayName": "Product Status",
      "type": "Choice",
      "required": true,
      "choices": [
        "Active",
        "Inactive",
        "Superseded",
        "Rescinded"
      ],
      "default": "Active",
      "ref": "Inactive = past the four-year periodic review without certify-as-current (DAFMAN 90-161 7.4.2; PFM 2026-11-11, the PFM's existing practice). Superseded and Rescinded trigger AFRIMS RDS T 33-38 R 07 for the record set (DAF Forms 673 and 399 and accompanying documentation); the publication and its index entry stay browsable"
    },
    {
      "internalName": "InactiveDate",
      "displayName": "Status Change Date",
      "type": "DateTime",
      "required": false,
      "ref": "Date Product Status last changed (Superseded, Rescinded or Inactive); T 33-38 R 07 trigger date for the record set"
    },
    {
      "internalName": "EffectiveDate",
      "displayName": "Effective Date",
      "type": "DateTime",
      "required": false,
      "ref": "DAFMAN 90-161 7.4.2 (review cycle runs from the effective date or last certified current date, whichever is later)"
    },
    {
      "internalName": "CertifiedCurrentDate",
      "displayName": "Last Certified Current Date",
      "type": "DateTime",
      "required": false,
      "ref": "DAFMAN 90-161 7.4.2, 7.5.1 (certify as current starts a new four-year cycle)"
    },
    {
      "internalName": "NextReviewDue",
      "displayName": "Next Review Due",
      "type": "DateTime",
      "required": false,
      "ref": "DAFMAN 90-161 7.4.2: four years after the later of Effective Date and Last Certified Current Date; the review task starts six months earlier. Set by a flow"
    }
  ],
  "views": [
    {
      "name": "Library - Active",
      "fields": [
        "PublicationNumber",
        "Title",
        "ProductType",
        "PublicationType",
        "Series",
        "OPR",
        "EffectiveDate"
      ],
      "orderBy": [
        {
          "field": "PublicationNumber",
          "ascending": true
        }
      ],
      "where": {
        "field": "ProductStatus",
        "op": "Eq",
        "type": "Choice",
        "value": "Active"
      },
      "default": false,
      "ref": "Users browse current products"
    },
    {
      "name": "Library - All Including Old",
      "fields": [
        "PublicationNumber",
        "Title",
        "ProductStatus",
        "InactiveDate",
        "Series"
      ],
      "orderBy": [
        {
          "field": "PublicationNumber",
          "ascending": true
        }
      ],
      "default": false,
      "ref": "Users browse old products (PFM 2026-11-11: rescinded publications stay reviewable)"
    },
    {
      "name": "PFM - By Number",
      "fields": [
        "PublicationNumber",
        "Title",
        "ProductType",
        "Publication",
        "PostedLink"
      ],
      "orderBy": [
        {
          "field": "PublicationNumber",
          "ascending": true
        }
      ],
      "default": false,
      "ref": "DAFMAN 90-161 6.4.2"
    },
    {
      "name": "PFM - Review Due",
      "fields": [
        "PublicationNumber",
        "Title",
        "EffectiveDate",
        "CertifiedCurrentDate",
        "NextReviewDue"
      ],
      "orderBy": [
        {
          "field": "NextReviewDue",
          "ascending": true
        }
      ],
      "default": false,
      "ref": "DAFMAN 90-161 7.4.2"
    },
    {
      "name": "PFM - Not Active",
      "fields": [
        "PublicationNumber",
        "Title",
        "ProductStatus",
        "InactiveDate",
        "Publication"
      ],
      "orderBy": [
        {
          "field": "InactiveDate",
          "ascending": true
        }
      ],
      "where": {
        "field": "ProductStatus",
        "op": "Neq",
        "type": "Choice",
        "value": "Active"
      },
      "default": false,
      "ref": "Inactive, Superseded or Rescinded; record sets of Superseded or Rescinded products are due for destruction (T 33-38 R 07)"
    }
  ]
}
