{
  "list": "PFMActivityLog",
  "title": "PFM Activity Log",
  "description": "Publications and Forms Manager (PFM) record of events: status change, endorsement requested, reminder sent, status report e-mailed. One row per event. Flow run history expires after 28 days; this list keeps the record.",
  "template": "GenericList",
  "ref": "PFM 2026-11-11 (naming doc: PFM Activity Log). Members read only; only the PFM office edits (PFM 2026-11-12, P2A).",
  "indexBuiltIn": [
    "Created"
  ],
  "fields": [
    {
      "internalName": "Title",
      "displayName": "Event",
      "type": "Text",
      "required": true,
      "builtIn": true,
      "ref": "Short event summary"
    },
    {
      "internalName": "Publication",
      "displayName": "Publication",
      "type": "Lookup",
      "required": false,
      "lookup": {
        "list": "PFMPublications",
        "showField": "Title"
      },
      "indexed": true,
      "ref": "Ties the event to its action"
    },
    {
      "internalName": "EventType",
      "displayName": "Event Type",
      "type": "Choice",
      "required": true,
      "choices": [
        "Status Changed",
        "Endorsement Requested",
        "Reminder Sent",
        "Endorsement Received",
        "Status Report E-Mailed",
        "Other",
        "Number Assigned",
        "Notice Sent",
        "Waiver Renewal Due",
        "Recommendation Received",
        "Review Requested"
      ],
      "ref": "PFM 2026-11-11 (events the flows record); \"E-Mailed\" per docs/style-standard.md (PFM 2026-11-11: DAFMAN 90-161 and The Tongue and Quill)"
    },
    {
      "internalName": "EventBy",
      "displayName": "Event By",
      "type": "User",
      "required": false,
      "ref": "Who caused the event (the flow's user for automatic events)"
    },
    {
      "internalName": "EventDetails",
      "displayName": "Event Details",
      "type": "Note",
      "required": false,
      "ref": "Free text; no publication content"
    }
  ],
  "views": [
    {
      "name": "PFM - Recent",
      "fields": [
        "Created",
        "Title",
        "EventType",
        "Publication",
        "EventBy"
      ],
      "orderBy": [
        {
          "field": "Created",
          "ascending": false
        }
      ],
      "default": false,
      "ref": "PFM 2026-11-11"
    }
  ]
}
