{
  "displayName": "90161Z F02 Next Review Due r1",
  "description": "Weekdays 07:00 Central. Sets PFM Product Index Next Review Due = 4 years after the later of Effective Date and Certified Current Date (DAFMAN 90-161 7.4.2); opens a periodic PFM Reviews row 6 months before it (7.4.4) if none is open.",
  "connections": [
    "shared_sharepointonline"
  ],
  "triggers": {
    "Recurrence_weekdays_0700_Central": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "timeZone": "Central Standard Time",
        "schedule": {
          "weekDays": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "hours": [
            "7"
          ],
          "minutes": [
            0
          ]
        },
        "startTime": "2026-11-16T07:00:00"
      }
    }
  },
  "actions": {
    "Today": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Central Standard Time'), 'yyyy-MM-dd')"
    },
    "Get_active_products": {
      "runAfter": {
        "Today": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Product Index (pfm_ListProductIndex)')",
          "$filter": "ProductStatus eq 'Active'",
          "$top": 5000
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      }
    },
    "For_each_active_product": {
      "runAfter": {
        "Get_active_products": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@body('Get_active_products')?['value']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Effective_date": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@coalesce(items('For_each_active_product')?['EffectiveDate'], '')"
        },
        "Certified_current_date": {
          "runAfter": {
            "Effective_date": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(items('For_each_active_product')?['CertifiedCurrentDate'], '')"
        },
        "Later_date": {
          "runAfter": {
            "Certified_current_date": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(empty(outputs('Effective_date')), outputs('Certified_current_date'), if(empty(outputs('Certified_current_date')), outputs('Effective_date'), if(greater(ticks(outputs('Effective_date')), ticks(outputs('Certified_current_date'))), outputs('Effective_date'), outputs('Certified_current_date'))))"
        },
        "Next_review_due": {
          "runAfter": {
            "Later_date": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(empty(outputs('Later_date')), '', addToTime(outputs('Later_date'), 4, 'Year', 'yyyy-MM-dd'))"
        },
        "Review_window_start": {
          "runAfter": {
            "Next_review_due": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(empty(outputs('Next_review_due')), '', addToTime(outputs('Next_review_due'), -6, 'Month', 'yyyy-MM-dd'))"
        },
        "If_next_review_due_differs": {
          "runAfter": {
            "Review_window_start": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@outputs('Next_review_due')",
                    ""
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@if(empty(items('For_each_active_product')?['NextReviewDue']), '', substring(items('For_each_active_product')?['NextReviewDue'], 0, 10))",
                    "@outputs('Next_review_due')"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Update_next_review_due": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Product Index (pfm_ListProductIndex)')",
                  "id": "@items('For_each_active_product')?['ID']",
                  "item/NextReviewDue": "@outputs('Next_review_due')"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Get_open_or_current_cycle_reviews": {
          "runAfter": {
            "If_next_review_due_differs": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
              "table": "@parameters('List PFM Reviews (pfm_ListReviews)')",
              "$filter": "@concat('Product/Id eq ', string(items('For_each_active_product')?['ID']), ' and ReviewType eq ''Periodic'' and (OPRResponse eq null or ReviewOpened ge ''', if(empty(outputs('Review_window_start')), '1900-01-01', outputs('Review_window_start')), 'T00:00:00Z'')')",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_review_task_due": {
          "runAfter": {
            "Get_open_or_current_cycle_reviews": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@outputs('Next_review_due')",
                    ""
                  ]
                }
              },
              {
                "greaterOrEquals": [
                  "@ticks(outputs('Today'))",
                  "@ticks(if(empty(outputs('Review_window_start')), '9999-12-31', outputs('Review_window_start')))"
                ]
              },
              {
                "equals": [
                  "@length(body('Get_open_or_current_cycle_reviews')?['value'])",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Create_periodic_review": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Reviews (pfm_ListReviews)')",
                  "item/Title": "@take(concat(coalesce(items('For_each_active_product')?['PublicationNumber'], items('For_each_active_product')?['Title']), ' periodic review due ', outputs('Next_review_due')), 250)",
                  "item/Product/Id": "@items('For_each_active_product')?['ID']",
                  "item/ReviewType/Value": "Periodic",
                  "item/ReviewOpened": "@outputs('Today')",
                  "item/OPRResponseDue": "@addDays(outputs('Today'), 30, 'yyyy-MM-dd')"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  }
}
