{
  "displayName": "90161Z F03 Suspense Reminders r1",
  "description": "Weekdays 07:00 Central. Sets the default suspense on open PFM Endorsements rows without one, then sends one reminder, warning or escalation e-mail per row and tier (DAFMAN 90-161 5.2, 5.2.1, 5.2.2, 5.4.3).",
  "connections": [
    "shared_sharepointonline",
    "shared_office365"
  ],
  "triggers": {
    "Recurrence_weekdays_0700_Central": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "timeZone": "Central Standard Time",
        "schedule": {
          "weekDays": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "hours": [
            "7"
          ],
          "minutes": [
            0
          ]
        },
        "startTime": "2026-11-16T07:00:00"
      }
    }
  },
  "actions": {
    "Today": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Central Standard Time'), 'yyyy-MM-dd')"
    },
    "Get_endorsements_without_suspense": {
      "runAfter": {
        "Today": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
          "$filter": "EndorsementStatus eq 'Not Started' and DueDate eq null and CoordinationStage ne 'Legal' and (CoordinationRole ne 'Legal' or CoordinationRole eq null)",
          "$top": 5000
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      }
    },
    "For_each_endorsement_without_suspense": {
      "runAfter": {
        "Get_endorsements_without_suspense": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@body('Get_endorsements_without_suspense')?['value']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Set_default_suspense": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
              "id": "@items('For_each_endorsement_without_suspense')?['ID']",
              "item/DueDate": "@if(or(equals(items('For_each_endorsement_without_suspense')?['CoordinationRole']?['Value'], 'Guard Applicability'), equals(items('For_each_endorsement_without_suspense')?['CoordinationRole']?['Value'], 'Reserve Applicability')), addDays(outputs('Today'), 30, 'yyyy-MM-dd'), addDays(outputs('Today'), 21, 'yyyy-MM-dd'))"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
    },
    "Get_open_endorsements": {
      "runAfter": {
        "For_each_endorsement_without_suspense": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
          "$filter": "EndorsementStatus eq 'Not Started' and DueDate ne null",
          "$top": 5000
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      }
    },
    "For_each_open_endorsement": {
      "runAfter": {
        "Get_open_endorsements": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@body('Get_open_endorsements')?['value']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Days_past": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@div(sub(ticks(outputs('Today')), ticks(substring(items('For_each_open_endorsement')?['DueDate'], 0, 10))), 864000000000)"
        },
        "Tier": {
          "runAfter": {
            "Days_past": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(greaterOrEquals(outputs('Days_past'), int(parameters('Escalation lag days (pfm_EscalationLagDays)'))), 'Escalation', if(greaterOrEquals(outputs('Days_past'), 0), 'Warning', if(greaterOrEquals(outputs('Days_past'), mul(-1, int(parameters('Reminder lead days (pfm_ReminderLeadDays)')))), 'Reminder', 'None')))"
        },
        "If_tier_and_endorser_e-mail": {
          "runAfter": {
            "Tier": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@outputs('Tier')",
                    "None"
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@coalesce(items('For_each_open_endorsement')?['Endorser']?['Email'], '')",
                    ""
                  ]
                }
              }
            ]
          },
          "actions": {
            "Get_prior_reminder": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                  "$filter": "@concat('Title eq ''', concat('Reminder Sent: E', string(items('For_each_open_endorsement')?['ID']), ' ', outputs('Tier')), '''')",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_not_yet_sent": {
              "runAfter": {
                "Get_prior_reminder": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@length(body('Get_prior_reminder')?['value'])",
                  0
                ]
              },
              "actions": {
                "Get_publication": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                      "id": "@items('For_each_open_endorsement')?['Publication']?['Id']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Copy_to": {
                  "runAfter": {
                    "Filter_AO_emails": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@if(equals(outputs('Tier'), 'Escalation'), concat(join(body('Filter_AO_emails'), ';'), if(and(greater(length(body('Filter_AO_emails')), 0), not(empty(body('Get_publication')?['Requester']?['Email']))), ';', ''), coalesce(body('Get_publication')?['Requester']?['Email'], '')), '')"
                },
                "Send_an_email_(V2)": {
                  "runAfter": {
                    "Copy_to": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2"
                    },
                    "authentication": "@parameters('$authentication')",
                    "parameters": {
                      "emailMessage/To": "@items('For_each_open_endorsement')?['Endorser']?['Email']",
                      "emailMessage/Cc": "@outputs('Copy_to')",
                      "emailMessage/Subject": "@concat(outputs('Tier'), ': coordination response due ', substring(items('For_each_open_endorsement')?['DueDate'], 0, 10), ' - ', coalesce(items('For_each_open_endorsement')?['Title'], ''))",
                      "emailMessage/Body": "@concat('<p>Coordination of ', coalesce(items('For_each_open_endorsement')?['Title'], 'a publication action'), ' is waiting for your response (DAFMAN 90-161, 5.2).</p>', '<p>Your suspense is ', substring(items('For_each_open_endorsement')?['DueDate'], 0, 10), if(equals(outputs('Tier'), 'Reminder'), '. This is an advance reminder.', if(equals(outputs('Tier'), 'Warning'), '. The suspense is today or has passed.', concat('. The suspense passed ', string(outputs('Days_past')), ' days ago.'))), '</p>', '<p>Please respond with Concur, Concur With Comment, Nonconcur or No Comment, or ask for an extension before the suspense with your rationale and estimated completion date (5.2.1).</p>', if(equals(outputs('Tier'), 'Escalation'), if(or(equals(items('For_each_open_endorsement')?['CoordinationRole']?['Value'], 'Legal'), equals(items('For_each_open_endorsement')?['CoordinationStage']?['Value'], 'Legal')), '<p>The action officer and requester are copied. Legal coordination cannot be closed as Concur - No Response (5.4.3).</p>', '<p>The action officer and requester are copied. The action officer may record Concur - No Response with an explanation in the staff package (5.4.3.2).</p>'), ''), '<p>This message is sent by the 90-161.Z publications flow.</p>')",
                      "emailMessage/Importance": "@if(equals(outputs('Tier'), 'Escalation'), 'High', 'Normal')"
                    }
                  }
                },
                "Log_reminder_sent": {
                  "runAfter": {
                    "Send_an_email_(V2)": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                      "item/Title": "@concat('Reminder Sent: E', string(items('For_each_open_endorsement')?['ID']), ' ', outputs('Tier'))",
                      "item/Publication/Id": "@items('For_each_open_endorsement')?['Publication']?['Id']",
                      "item/EventType/Value": "Reminder Sent",
                      "item/EventDetails": "@concat(outputs('Tier'), ' e-mail sent for endorsement row ', string(items('For_each_open_endorsement')?['ID']), '; suspense ', substring(items('For_each_open_endorsement')?['DueDate'], 0, 10))"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Select_AO_emails": {
                  "runAfter": {
                    "Get_publication": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@coalesce(body('Get_publication')?['AO'], json('[]'))",
                    "select": "@item()?['Email']"
                  }
                },
                "Filter_AO_emails": {
                  "runAfter": {
                    "Select_AO_emails": [
                      "Succeeded"
                    ]
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Select_AO_emails')",
                    "where": "@not(empty(item()))"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    }
  }
}
