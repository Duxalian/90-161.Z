{
  "displayName": "90161Z F01 Activity Log r1",
  "description": "When a PFM Publications row is created or modified, writes a PFM Activity Log row if Action Type, Process Step or Action Status differs from the last logged state.",
  "connections": [
    "shared_sharepointonline"
  ],
  "triggers": {
    "When_an_item_is_created_or_modified": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Publications (pfm_ListPublications)')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Get_last_logged_state": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
          "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']), ' and EventType eq ''Status Changed''')",
          "$orderby": "ID desc",
          "$top": 1
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Current_state": {
      "runAfter": {
        "Get_last_logged_state": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@concat(coalesce(triggerBody()?['ActionType']?['Value'], ''), ' | ', coalesce(triggerBody()?['ProcessStep']?['Value'], ''), ' | ', coalesce(triggerBody()?['ActionStatus']?['Value'], ''))"
    },
    "Last_logged_state": {
      "runAfter": {
        "Current_state": [
          "Succeeded"
        ]
      },
      "type": "Compose",
      "inputs": "@if(empty(body('Get_last_logged_state')?['value']), '', trim(last(split(coalesce(first(body('Get_last_logged_state')?['value'])?['EventDetails'], ''), 'State: '))))"
    },
    "If_state_changed": {
      "runAfter": {
        "Last_logged_state": [
          "Succeeded"
        ]
      },
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@outputs('Last_logged_state')",
            "@outputs('Current_state')"
          ]
        }
      },
      "actions": {
        "Create_activity_log_row": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem"
            },
            "parameters": {
              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
              "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
              "item/Title": "@take(concat(if(empty(body('Get_last_logged_state')?['value']), 'Action opened: ', 'Action updated: '), coalesce(triggerBody()?['Title'], '')), 250)",
              "item/Publication/Id": "@triggerBody()?['ID']",
              "item/EventType/Value": "Status Changed",
              "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
              "item/EventDetails": "@concat(if(empty(body('Get_last_logged_state')?['value']), 'Opened. ', 'Changed. '), 'State: ', outputs('Current_state'))"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
