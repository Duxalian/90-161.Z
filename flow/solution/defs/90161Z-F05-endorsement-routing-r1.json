{
  "displayName": "90161Z F05 Endorsement Routing r1",
  "description": "When a PFM Publications row is at process step 6 (Formal coordination): creates the Formal Coordination endorsement rows from PFM Offices once; when every other coordinator has answered and all comments are adjudicated, creates the Legal rows and moves the step to 7 (Legal coordination). DAFMAN 90-161 3.4, 5.1, 5.1.8.2; PFM S5A, 2026-11-14.",
  "connections": [
    "shared_sharepointonline"
  ],
  "triggers": {
    "When_an_item_is_created_or_modified": {
      "type": "OpenApiConnection",
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Publications (pfm_ListPublications)')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "If_step_set": {
      "runAfter": {},
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@coalesce(string(triggerBody()?['ProcessStep']?['Id']), '')",
            ""
          ]
        }
      },
      "actions": {
        "Get_process_step": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
              "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
              "id": "@triggerBody()?['ProcessStep']?['Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_formal_coordination": {
          "runAfter": {
            "Get_process_step": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "equals": [
              "@body('Get_process_step')?['StepNumber']",
              6
            ]
          },
          "actions": {
            "Get_formal_rows": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                  "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']), ' and CoordinationStage eq ''Formal Coordination''')",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_legal_rows": {
              "runAfter": {
                "Get_formal_rows": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                  "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                  "$filter": "@concat('Publication/Id eq ', string(triggerBody()?['ID']), ' and CoordinationStage eq ''Legal''')",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Pending_rows": {
              "runAfter": {
                "Get_legal_rows": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_formal_rows')?['value']",
                "where": "@and(equals(item()?['EndorsementStatus']?['Value'], 'Not Started'), not(equals(item()?['CoordinationRole']?['Value'], 'Legal')))"
              }
            },
            "If_no_formal_rows": {
              "runAfter": {
                "Pending_rows": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@length(body('Get_formal_rows')?['value'])",
                  0
                ]
              },
              "actions": {
                "Get_mandatory_offices": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                      "$filter": "MandatoryCoordinator eq 1 and IsActive eq 1 and CoordinateLast eq 0",
                      "$top": 500
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Create_formal_rows": {
                  "runAfter": {
                    "Get_mandatory_offices": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach",
                  "foreach": "@body('Get_mandatory_offices')?['value']",
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "If_office_has_endorser_Formal": {
                      "runAfter": {},
                      "type": "If",
                      "expression": {
                        "not": {
                          "equals": [
                            "@coalesce(items('Create_formal_rows')?['Endorser']?['Claims'], '')",
                            ""
                          ]
                        }
                      },
                      "actions": {
                        "Create_row_with_endorser_Formal": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem"
                            },
                            "parameters": {
                              "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                              "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                              "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_formal_rows')?['Title'], '')), 250)",
                              "item/Publication/Id": "@triggerBody()?['ID']",
                              "item/CoordinationStage/Value": "Formal Coordination",
                              "item/CoordinationRole/Value": "@items('Create_formal_rows')?['CoordinationRole']?['Value']",
                              "item/IsRequired": true,
                              "item/EndorsementStatus/Value": "Not Started",
                              "item/Endorser/Claims": "@items('Create_formal_rows')?['Endorser']?['Claims']"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Create_row_without_endorser_Formal": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PostItem"
                              },
                              "parameters": {
                                "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_formal_rows')?['Title'], '')), 250)",
                                "item/Publication/Id": "@triggerBody()?['ID']",
                                "item/CoordinationStage/Value": "Formal Coordination",
                                "item/CoordinationRole/Value": "@items('Create_formal_rows')?['CoordinationRole']?['Value']",
                                "item/IsRequired": true,
                                "item/EndorsementStatus/Value": "Not Started"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "Log_formal_rows": {
                  "runAfter": {
                    "Create_formal_rows": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                      "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                      "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                      "item/Publication/Id": "@triggerBody()?['ID']",
                      "item/EventType/Value": "Endorsement Requested",
                      "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                      "item/EventDetails": "@concat('Formal Coordination rows created from PFM Offices (mandatory, active, not Legal): ', string(length(body('Get_mandatory_offices')?['value'])), '. DAFMAN 90-161 3.4, 5.1.')"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "else": {
                "actions": {
                  "If_ready_for_Legal": {
                    "runAfter": {},
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@length(body('Get_legal_rows')?['value'])",
                            0
                          ]
                        },
                        {
                          "equals": [
                            "@length(body('Pending_rows'))",
                            0
                          ]
                        },
                        {
                          "equals": [
                            "@coalesce(triggerBody()?['AllCommentsAdjudicated'], false)",
                            true
                          ]
                        }
                      ]
                    },
                    "actions": {
                      "Get_legal_offices": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "GetItems"
                          },
                          "parameters": {
                            "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                            "table": "@parameters('List PFM Offices (pfm_ListOffices)')",
                            "$filter": "CoordinateLast eq 1 and IsActive eq 1",
                            "$top": 500
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Create_legal_rows": {
                        "runAfter": {
                          "Get_legal_offices": [
                            "Succeeded"
                          ]
                        },
                        "type": "Foreach",
                        "foreach": "@body('Get_legal_offices')?['value']",
                        "runtimeConfiguration": {
                          "concurrency": {
                            "repetitions": 1
                          }
                        },
                        "actions": {
                          "If_office_has_endorser_Legal": {
                            "runAfter": {},
                            "type": "If",
                            "expression": {
                              "not": {
                                "equals": [
                                  "@coalesce(items('Create_legal_rows')?['Endorser']?['Claims'], '')",
                                  ""
                                ]
                              }
                            },
                            "actions": {
                              "Create_row_with_endorser_Legal": {
                                "runAfter": {},
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PostItem"
                                  },
                                  "parameters": {
                                    "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                    "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                    "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows')?['Title'], '')), 250)",
                                    "item/Publication/Id": "@triggerBody()?['ID']",
                                    "item/CoordinationStage/Value": "Legal",
                                    "item/CoordinationRole/Value": "@items('Create_legal_rows')?['CoordinationRole']?['Value']",
                                    "item/IsRequired": true,
                                    "item/EndorsementStatus/Value": "Not Started",
                                    "item/Endorser/Claims": "@items('Create_legal_rows')?['Endorser']?['Claims']"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              }
                            },
                            "else": {
                              "actions": {
                                "Create_row_without_endorser_Legal": {
                                  "runAfter": {},
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                      "connectionName": "shared_sharepointonline",
                                      "operationId": "PostItem"
                                    },
                                    "parameters": {
                                      "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                                      "table": "@parameters('List PFM Endorsements (pfm_ListEndorsements)')",
                                      "item/Title": "@take(concat(coalesce(triggerBody()?['Title'], ''), ' - ', coalesce(items('Create_legal_rows')?['Title'], '')), 250)",
                                      "item/Publication/Id": "@triggerBody()?['ID']",
                                      "item/CoordinationStage/Value": "Legal",
                                      "item/CoordinationRole/Value": "@items('Create_legal_rows')?['CoordinationRole']?['Value']",
                                      "item/IsRequired": true,
                                      "item/EndorsementStatus/Value": "Not Started"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "Get_legal_step": {
                        "runAfter": {
                          "Create_legal_rows": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "GetItems"
                          },
                          "parameters": {
                            "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                            "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
                            "$filter": "StepNumber eq 7",
                            "$top": 1
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Move_to_legal_step": {
                        "runAfter": {
                          "Get_legal_step": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "parameters": {
                            "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                            "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
                            "id": "@triggerBody()?['ID']",
                            "item/Title": "@triggerBody()?['Title']",
                            "item/ProcessStep/Id": "@first(body('Get_legal_step')?['value'])?['ID']"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Log_legal_rows": {
                        "runAfter": {
                          "Move_to_legal_step": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PostItem"
                          },
                          "parameters": {
                            "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
                            "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
                            "item/Title": "@take(concat('Endorsements requested: ', coalesce(triggerBody()?['Title'], '')), 250)",
                            "item/Publication/Id": "@triggerBody()?['ID']",
                            "item/EventType/Value": "Endorsement Requested",
                            "item/EventBy/Claims": "@triggerBody()?['Editor']?['Claims']",
                            "item/EventDetails": "@concat('All other coordinators answered and comments adjudicated; Legal rows created: ', string(length(body('Get_legal_offices')?['value'])), '; step moved to Legal coordination. DAFMAN 90-161 5.1.8.2.')"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    },
                    "else": {
                      "actions": {}
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
