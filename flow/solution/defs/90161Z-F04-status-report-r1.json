{
  "displayName": "90161Z F04 Status Report r1",
  "description": "Run on demand. E-mails the person named at run time an HTML table of PFM Publications actions grouped by Process Step (DECISIONS 2026-11-11: status report to anyone at any time; DAFMAN 90-161 2.6.8).",
  "connections": [
    "shared_sharepointonline",
    "shared_office365"
  ],
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": "Send the report to (e-mail)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "x-ms-content-hint": "TEXT",
              "description": "One e-mail address"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    }
  },
  "actions": {
    "Report_html": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ReportHtml",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Get_process_steps": {
      "runAfter": {
        "Report_html": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Process Steps (pfm_ListProcessSteps)')",
          "$orderby": "StepNumber asc",
          "$top": 100
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Get_publications": {
      "runAfter": {
        "Get_process_steps": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Publications (pfm_ListPublications)')",
          "$top": 5000
        },
        "authentication": "@parameters('$authentication')"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      }
    },
    "For_each_process_step": {
      "runAfter": {
        "Get_publications": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@body('Get_process_steps')?['value']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Actions_at_this_step": {
          "runAfter": {},
          "type": "Query",
          "inputs": {
            "from": "@body('Get_publications')?['value']",
            "where": "@equals(item()?['ProcessStep']?['Id'], items('For_each_process_step')?['ID'])"
          }
        },
        "If_any_actions": {
          "runAfter": {
            "Actions_at_this_step": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@length(body('Actions_at_this_step'))",
              0
            ]
          },
          "actions": {
            "Create_HTML_table": {
              "runAfter": {},
              "type": "Table",
              "inputs": {
                "from": "@body('Actions_at_this_step')",
                "format": "HTML",
                "columns": [
                  {
                    "header": "Number",
                    "value": "@coalesce(item()?['PublicationNumber'], '')"
                  },
                  {
                    "header": "Title",
                    "value": "@coalesce(item()?['Title'], '')"
                  },
                  {
                    "header": "Action",
                    "value": "@coalesce(item()?['ActionType']?['Value'], '')"
                  },
                  {
                    "header": "Status",
                    "value": "@coalesce(item()?['ActionStatus']?['Value'], '')"
                  },
                  {
                    "header": "Coordination suspense",
                    "value": "@if(empty(item()?['CoordinationSuspense']), '', substring(item()?['CoordinationSuspense'], 0, 10))"
                  }
                ]
              }
            },
            "Append_stage_section": {
              "runAfter": {
                "Create_HTML_table": [
                  "Succeeded"
                ]
              },
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "ReportHtml",
                "value": "@concat('<h3>Step ', string(items('For_each_process_step')?['StepNumber']), ': ', coalesce(items('For_each_process_step')?['Title'], ''), ' (', string(length(body('Actions_at_this_step'))), ')</h3>', body('Create_HTML_table'))"
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "Send_the_report_(V2)": {
      "runAfter": {
        "For_each_process_step": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2"
        },
        "authentication": "@parameters('$authentication')",
        "parameters": {
          "emailMessage/To": "@triggerBody()?['text']",
          "emailMessage/Subject": "@concat('90-161.Z status report ', formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Central Standard Time'), 'yyyy-MM-dd'))",
          "emailMessage/Body": "@concat('<p>Open publication actions by process step. Generated ', formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Central Standard Time'), 'yyyy-MM-dd'), ' (Central).</p>', if(empty(variables('ReportHtml')), '<p>No actions found.</p>', variables('ReportHtml')))"
        }
      }
    },
    "Log_status_report": {
      "runAfter": {
        "Send_the_report_(V2)": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
        },
        "parameters": {
          "dataset": "@parameters('Site URL (pfm_SiteUrl)')",
          "table": "@parameters('List PFM Activity Log (pfm_ListActivityLog)')",
          "item/Title": "Status report e-mailed",
          "item/EventType/Value": "Status Report E-Mailed",
          "item/EventDetails": "@concat('Report covered ', string(length(body('Get_publications')?['value'])), ' actions.')"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  }
}
