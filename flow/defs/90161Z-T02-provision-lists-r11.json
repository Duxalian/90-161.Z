{
  "displayName": "90161Z T02 Provision Lists r11",
  "description": "Creates the twelve Publications and Forms Manager (PFM) lists, their columns, views and indexes from flow/provisioning-payload.json (embedded at build), adds the series, settings, office and process step rows, sets display titles, then sets item-level permissions (read all, edit own) on PFM Publications and PFM Endorsements. Asks for the site address only. One request at a time, in payload order. For a new site: a second run fails on lists that exist.",
  "connections": [
    "shared_sharepointonline"
  ],
  "embed": {
    "Payload": "flow/provisioning-payload.json"
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "text": {
              "title": "Site URL",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Full site address, https://.../sites/...",
              "x-ms-content-hint": "TEXT"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    }
  },
  "actions": {
    "Payload": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "replaced at build from flow/provisioning-payload.json"
    },
    "Create_Lists": {
      "runAfter": {
        "Payload": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['lists']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Create_List": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Create_Lists')?['uri']",
              "parameters/headers": {
                "Accept": "application/json;odata=verbose",
                "Content-Type": "application/json;odata=verbose"
              },
              "parameters/body": "@string(items('Create_Lists')?['body'])"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        }
      }
    },
    "Get_Offices_ID": {
      "runAfter": {
        "Create_Lists": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFMOffices')?$select=Id",
          "parameters/headers": {
            "Accept": "application/json;odata=verbose"
          }
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    },
    "Get_ProcessSteps_ID": {
      "runAfter": {
        "Get_Offices_ID": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFMProcessSteps')?$select=Id",
          "parameters/headers": {
            "Accept": "application/json;odata=verbose"
          }
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    },
    "Get_ProductIndex_ID": {
      "runAfter": {
        "Get_ProcessSteps_ID": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFMProductIndex')?$select=Id",
          "parameters/headers": {
            "Accept": "application/json;odata=verbose"
          }
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    },
    "Get_Publications_ID": {
      "runAfter": {
        "Get_ProductIndex_ID": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFMPublications')?$select=Id",
          "parameters/headers": {
            "Accept": "application/json;odata=verbose"
          }
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    },
    "Get_Series_ID": {
      "runAfter": {
        "Get_Publications_ID": [
          "Succeeded"
        ]
      },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('PFMSeries')?$select=Id",
          "parameters/headers": {
            "Accept": "application/json;odata=verbose"
          }
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "authentication": {
          "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
          "type": "Raw"
        }
      }
    },
    "Create_Fields_And_Views": {
      "runAfter": {
        "Get_Series_ID": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['fields']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Create_Field_Or_View": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Create_Fields_And_Views')?['uri']",
              "parameters/headers": {
                "Accept": "application/json;odata=verbose",
                "Content-Type": "application/json;odata=verbose"
              },
              "parameters/body": "@replace(replace(replace(replace(replace(string(items('Create_Fields_And_Views')?['body']), '__PFMOffices_ID__', body('Get_Offices_ID')?['d']?['Id']), '__PFMProcessSteps_ID__', body('Get_ProcessSteps_ID')?['d']?['Id']), '__PFMProductIndex_ID__', body('Get_ProductIndex_ID')?['d']?['Id']), '__PFMPublications_ID__', body('Get_Publications_ID')?['d']?['Id']), '__PFMSeries_ID__', body('Get_Series_ID')?['d']?['Id'])"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        }
      }
    },
    "Add_Rows": {
      "runAfter": {
        "Create_Fields_And_Views": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['rows']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Add_Row": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Add_Rows')?['uri']",
              "parameters/headers": {
                "Accept": "application/json;odata=verbose",
                "Content-Type": "application/json;odata=verbose"
              },
              "parameters/body": "@string(items('Add_Rows')?['body'])"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        }
      }
    },
    "Apply_Updates": {
      "runAfter": {
        "Add_Rows": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['updates']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Apply_Update": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Apply_Updates')?['uri']",
              "parameters/headers": {
                "Accept": "application/json;odata=verbose",
                "Content-Type": "application/json;odata=verbose",
                "X-HTTP-Method": "MERGE",
                "IF-MATCH": "*"
              },
              "parameters/body": "@string(items('Apply_Updates')?['body'])"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        }
      }
    },
    "Set_Item_Permissions": {
      "runAfter": {
        "Apply_Updates": [
          "Succeeded"
        ]
      },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['permissions']",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Set_Item_Permission": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Set_Item_Permissions')?['uri']",
              "parameters/headers": {
                "Accept": "application/json;odata=verbose",
                "Content-Type": "application/json;odata=verbose",
                "X-HTTP-Method": "MERGE",
                "IF-MATCH": "*"
              },
              "parameters/body": "@string(items('Set_Item_Permissions')?['body'])"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          }
        }
      }
    },
    "Result": {
      "runAfter": {
        "Set_Item_Permissions": [
          "Succeeded",
          "Failed"
        ]
      },
      "type": "Compose",
      "inputs": "@concat('Lists: ', string(length(outputs('Payload')?['lists'])), ', fields and views: ', string(length(outputs('Payload')?['fields'])), ', rows: ', string(length(outputs('Payload')?['rows'])), ', updates: ', string(length(outputs('Payload')?['updates'])), '. Provisioning finished. ', if(equals(actions('Set_Item_Permissions')?['status'], 'Succeeded'), concat('Item-level permissions: set on ', string(length(outputs('Payload')?['permissions'])), ' lists.'), 'Item-level permissions: NOT SET. Set them by hand (go.md Task 2, step 7).'))"
    }
  }
}
