{
  "displayName": "90161Z T02 Provision lists r1",
  "description": "Creates the 90-161.Z lists, fields and views from flow/provisioning-payload.json (embedded at build). Asks for the site URL at run time (no site path in the repo). One request at a time, in payload order. Stage seed rows are not sent (stages not yet approved).",
  "connections": ["shared_sharepointonline"],
  "embed": { "Payload": "flow/provisioning-payload.json" },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "text": { "title": "Site URL", "type": "string", "x-ms-dynamically-added": true, "description": "Full site address, https://.../sites/...", "x-ms-content-hint": "TEXT" }
          },
          "required": ["text"]
        }
      }
    }
  },
  "actions": {
    "Payload": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "replaced at build from flow/provisioning-payload.json"
    },
    "Create_lists": {
      "runAfter": { "Payload": ["Succeeded"] },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['lists']",
      "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
      "actions": {
        "Create_list": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Create_lists')?['uri']",
              "parameters/headers": { "Accept": "application/json;odata=verbose", "Content-Type": "application/json;odata=verbose" },
              "parameters/body": "@string(items('Create_lists')?['body'])"
            },
            "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "HttpRequest" },
            "authentication": { "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']", "type": "Raw" }
          }
        }
      }
    },
    "Get_Stages_ID": {
      "runAfter": { "Create_lists": ["Succeeded", "Failed"] },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('Stages')?$select=Id",
          "parameters/headers": { "Accept": "application/json;odata=verbose" }
        },
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "HttpRequest" },
        "authentication": { "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']", "type": "Raw" }
      }
    },
    "Get_Publications_ID": {
      "runAfter": { "Get_Stages_ID": ["Succeeded"] },
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "@triggerBody()['text']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('Publications')?$select=Id",
          "parameters/headers": { "Accept": "application/json;odata=verbose" }
        },
        "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "HttpRequest" },
        "authentication": { "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']", "type": "Raw" }
      }
    },
    "Create_fields_and_views": {
      "runAfter": { "Get_Publications_ID": ["Succeeded"] },
      "type": "Foreach",
      "foreach": "@outputs('Payload')?['fields']",
      "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
      "actions": {
        "Create_field_or_view": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@triggerBody()['text']",
              "parameters/method": "POST",
              "parameters/uri": "@items('Create_fields_and_views')?['uri']",
              "parameters/headers": { "Accept": "application/json;odata=verbose", "Content-Type": "application/json;odata=verbose" },
              "parameters/body": "@replace(replace(string(items('Create_fields_and_views')?['body']), '__Stages_ID__', body('Get_Stages_ID')?['d']?['Id']), '__Publications_ID__', body('Get_Publications_ID')?['d']?['Id'])"
            },
            "host": { "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline", "connectionName": "shared_sharepointonline", "operationId": "HttpRequest" },
            "authentication": { "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']", "type": "Raw" }
          }
        }
      }
    },
    "Result": {
      "runAfter": { "Create_fields_and_views": ["Succeeded"] },
      "type": "Compose",
      "inputs": "@concat('Lists: ', string(length(outputs('Payload')?['lists'])), ', fields and views: ', string(length(outputs('Payload')?['fields'])) , ' - provisioning finished')"
    }
  }
}
